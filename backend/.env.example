# Copy to .env and adjust. All variables are prefixed MINTREE_.
MINTREE_DATABASE_URL=postgresql+psycopg://mintree:mintree@localhost:5433/mintree
MINTREE_ENVIRONMENT=development
MINTREE_COOKIE_SECURE=false        # set true behind HTTPS
MINTREE_STORAGE_ROOT=storage
MINTREE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
MINTREE_BOOTSTRAP_ADMIN_PASSWORD=  # leave blank to have a random one printed by `python -m app.seed`

# --- AI layer (off by default; see docs/AI_LAYER.md). The key belongs in the environment only, never in the repository.
MINTREE_AI_ENABLED=false
MINTREE_AI_PROVIDER=anthropic
MINTREE_AI_API_KEY=
MINTREE_AI_MODEL=claude-sonnet-5-5
MINTREE_AI_EXTRACT_MODEL=claude-haiku-5-5
MINTREE_AI_DAILY_TOKEN_BUDGET_PER_USER=200000
