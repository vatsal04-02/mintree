# Copy to .env and replace every CHANGE_ME. Never commit the real file.
MINTREE_DOMAIN=mintree.example.com
POSTGRES_PASSWORD=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
# First administrator (must change the password at first login). Used only when no user exists yet.
MINTREE_BOOTSTRAP_ADMIN_EMAIL=admin@your-company.example
MINTREE_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_long_and_unique
# Inbound webhook HMAC keys (courier and marketplace). The development defaults are refused in production by review, not by code: set real values.
MINTREE_COURIER_WEBHOOK_SECRET=CHANGE_ME
MINTREE_MARKETPLACE_WEBHOOK_SECRET=CHANGE_ME
# Prometheus scrape token for /api/metrics (the Caddyfile hides that path from the internet; scrape it on the internal network).
MINTREE_METRICS_TOKEN=CHANGE_ME
